# Copy to .env.local before running the frontend:
#   cp .env.local.example .env.local

# Production (server behind Apache): use same-origin path so browsers hit lmsbr.com/api/v3
NEXT_PUBLIC_API_URL=/api/v3

# Local dev on your laptop (uncomment when using `npm run dev` against local Django):
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v3
LMSBR_DJANGO_ORIGIN=http://127.0.0.1:8000
