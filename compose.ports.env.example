# Copy to compose.ports.env (gitignored) to override host ports in docker-compose.yml
# Usage: cp compose.ports.env.example compose.ports.env

# NGINX_PORT=8080   # used with: make start-nginx
# DJANGO_PORT=8000
# POSTGRES_PORT=5433   # default in compose — avoids local PostgreSQL on 5432
# REDIS_PORT=6379
